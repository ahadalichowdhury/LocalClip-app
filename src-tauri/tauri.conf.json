{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalClip",
  "version": "2.1.0",
  "identifier": "com.localclip.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LocalClip",
        "url": "index.html",
        "width": 400,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 360,
        "minHeight": 420,
        "maxWidth": 480,
        "maxHeight": 680,
        "minimizable": false,
        "maximizable": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2024 S. M. Ahad Ali Chowdhury",
    "shortDescription": "Clipboard manager",
    "longDescription": "A modern, Windows 11-inspired clipboard manager with local storage and privacy-first design.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwM0JCNDI2MDc1RUVGOUQKUldTZDcxNEhKclE3TUl4L1pjVWViWXVwM29kcEVFSkxkTGVFRnQ3UEcyZzVJN25CVHEyZkhDdlEK",
      "endpoints": [
        "https://github.com/ahadalichowdhury/LocalClip-app/releases/latest/download/latest.json"
      ]
    }
  }
}
