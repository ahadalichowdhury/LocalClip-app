{
  "name": "localclip",
  "version": "1.0.0",
  "description": "A modern, Windows 11-inspired clipboard manager for macOS (Tauri + Rust)",
  "homepage": "https://github.com/ahadalichowdhury/LocalClip",
  "author": {
    "name": "S. M. Ahad Ali Chowdhury",
    "email": "smahadalichowdhury@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:universal": "tauri build --target universal-apple-darwin",
    "dev:web": "vite",
    "build:web": "vite build",
    "tauri": "tauri",
    "test": "jest && npm run test:rust",
    "test:js": "jest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "framer-motion": "^10.16.16",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.4.1",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.8",
    "unicode-emoji-json": "0.8.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "productivity",
    "utility",
    "react",
    "typescript",
    "tauri",
    "rust",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ahadalichowdhury/LocalClip"
  },
  "bugs": {
    "url": "https://github.com/ahadalichowdhury/LocalClip"
  }
}
